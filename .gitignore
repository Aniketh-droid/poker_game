# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Environment variables
.env

# Local tool state -- machine-specific config/cache for Claude Code hooks and
# the "Impeccable" design-linting tool (absolute local paths, review screenshots,
# consent/cache files). Not project source; safe to `git add .`/`-A` around.
.claude/
.impeccable/
.github/hooks/

# Archived research/CLI tooling (main.py, play_human.py, experiments/, and the
# benchmark plots they generated) -- moved out of the tracked project because
# it's the pre-pivot 2-player academic benchmark, not the playable multiway
# game. Kept on disk for reference, deliberately not shipped to GitHub.
archive/
