# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Environment variables
.env

# Generated benchmark plots (regenerated on demand by main.py / the Simulation
# Arena tab -- see experiments/visualize.py's os.makedirs(..., exist_ok=True)).
# Not committing these keeps the repo from accumulating stale run artifacts.
static/plots/*.png
