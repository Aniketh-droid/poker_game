# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Environment variables
.env

# Generated benchmark plots (regenerated on demand by main.py / the Simulation
# Arena tab -- see experiments/visualize.py's os.makedirs(..., exist_ok=True)).
# Not committing these keeps the repo from accumulating stale run artifacts.
static/plots/*.png

# Local tool state -- machine-specific config/cache for Claude Code hooks and
# the "Impeccable" design-linting tool (absolute local paths, review screenshots,
# consent/cache files). Not project source; safe to `git add .`/`-A` around.
.claude/
.impeccable/
.github/hooks/
